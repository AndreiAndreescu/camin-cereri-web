# Copiaza acest fisier in ".env.local" (local) si completeaza valorile reale
# din Supabase Dashboard -> Settings -> API. In productie (Vercel), aceleasi
# variabile se pun in Project Settings -> Environment Variables.

# Settings -> API -> Project URL
SUPABASE_URL=

# Settings -> API -> Project API keys -> anon / public
SUPABASE_ANON_KEY=

# Settings -> API -> Project API keys -> service_role (SECRET - nu se expune niciodata in browser)
SUPABASE_SERVICE_ROLE_KEY=

# Un sir de caractere lung si aleator, folosit doar ca sa semneze cookie-ul
# de sesiune al aplicatiei. Genereaza unul cu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
